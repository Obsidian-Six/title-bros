# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/titlebros_db?retryWrites=true&w=majority

# JWT Settings
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=1d
JWT_COOKIE_EXPIRE=1

# Inactivity Timeout Settings (in minutes)
SESSION_INACTIVITY_TIMEOUT_ADMIN=15
SESSION_INACTIVITY_TIMEOUT_CUSTOMER=60

# Initial Super Admin Seed
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL=superadmin@titlebros.com
SUPER_ADMIN_PASSWORD=YourStrongPasswordHere!

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME="Title Bros Loans"
EMAIL_FROM_ADDRESS="no-reply@titlebros.com"
